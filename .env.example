# --- Envoi d'emails (formulaires) : Resend ---
# https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Adresse qui reçoit les demandes (ton client)
CONTACT_TO_EMAIL=info@traiteurcamelot.com
# Expéditeur vérifié dans Resend (domaine ou onboarding@resend.dev en test)
CONTACT_FROM_EMAIL="Camelot — Site web <noreply@traiteurcamelot.com>"

# --- Anti-spam : Cloudflare Turnstile (gratuit) ---
# https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_yyyyyyyyyyyy

# --- URL canonique du site (sans / final) ---
NEXT_PUBLIC_SITE_URL=https://traiteurcamelot.com
